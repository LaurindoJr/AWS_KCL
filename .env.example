# Database Configuration
POSTGRES_DB=library
POSTGRES_USER=user
POSTGRES_PASSWORD=password

# MinIO Configuration (S3-compatible storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=miniopassword
S3_BUCKET=books

# RabbitMQ Configuration (for async tasks)
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_QUEUE=image_processing

# AWS Configuration (optional - only needed for audit logging to DynamoDB)
# Se estiver usando credenciais temporárias da AWS, preencha este campo
AWS_SESSION_TOKEN=
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1

# DynamoDB Table for Audit Logs (optional)
DDB_AUDIT=kcl-AuditLogs
DDB_STATUS=kcl-ProcessingStatus
